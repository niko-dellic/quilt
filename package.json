{
  "name": "quilt-workspace",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/docs"
  ],
  "scripts": {
    "build": "npm run build -w quilt-core && npm run build -w quilt-vanilla && npm run build -w quilt-react",
    "typecheck": "tsc -p tsconfig.demo.json --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:packed": "node scripts/test-packed.mjs",
    "dev": "vite --host localhost --port 5186",
    "build:demos": "vite build",
    "pack:all": "node scripts/pack.mjs",
    "check": "npm run docs:check && npm run format:check && npm run test:release && npm run build && npm run typecheck && npm test && npm run test:browser && npm run build:demos && npm run test:packed && npm run test:examples && npm run docs:build && npm run docs:test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:version": "node scripts/release-version.mjs",
    "test:release": "node --test scripts/release.test.mjs",
    "test:examples": "node scripts/test-examples.mjs",
    "release:rehearse": "node scripts/rehearse-release.mjs",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "package:desktop": "npm run build && node scripts/build-desktop.mjs --package",
    "test:desktop": "node scripts/test-desktop.mjs",
    "docs:sync": "node scripts/sync-readmes.mjs",
    "docs:check": "node scripts/sync-readmes.mjs --check",
    "docs:api": "npm run generate -w quilt-docs",
    "docs:dev": "npm run dev -w quilt-docs",
    "docs:build": "npm run build -w quilt-docs",
    "docs:test": "node scripts/check-docs.mjs",
    "build:site": "npm run build:demos && npm run docs:build"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "lucide": "1.47.0",
    "prettier": "3.9.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
