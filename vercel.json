{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build && npm run build:demos",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/themes.html",
      "destination": "/vanilla.html",
      "permanent": true
    }
  ]
}
