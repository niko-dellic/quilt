{
  "name": "quilt-three",
  "version": "0.11.0",
  "description": "Shared-scene Three.js viewports for Quilt",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webgpu": {
      "types": "./dist/webgpu.d.ts",
      "import": "./dist/webgpu.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs three",
    "prepack": "node ../../scripts/build-package.mjs three --dependencies"
  },
  "dependencies": {
    "quilt-vanilla": "0.11.0",
    "@types/three": "^0.186.0"
  },
  "peerDependencies": {
    "three": "^0.186.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niko-dellic/quilt.git",
    "directory": "packages/three"
  },
  "homepage": "https://github.com/niko-dellic/quilt/tree/main/packages/three"
}
