  },
  "peerDependencies": {
    "three": "^0.186.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@react-three/fiber": "^9.8.1"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niko-dellic/quilt.git",
    "directory": "packages/three-react"
  },
