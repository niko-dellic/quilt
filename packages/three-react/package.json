{
  "name": "quilt-three-react",
  "version": "0.11.0",
  "description": "React Three Fiber bindings for Quilt shared-scene viewports",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
